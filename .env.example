# Both modes default to mock and require no Shopify credentials.
SHOPIFY_DATA_MODE=mock
SHOPIFY_EXECUTION_MODE=mock

# Required only after intentionally switching SHOPIFY_DATA_MODE to live.
SHOPIFY_SHOP=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Required only after intentionally switching SHOPIFY_EXECUTION_MODE to live.
# Private Headless Storefront token. Server-only; never use a public environment prefix.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Optional non-secret override. Defaults to 2026-07 when omitted.
SHOPIFY_API_VERSION=
